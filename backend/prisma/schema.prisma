// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  WRITER
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

// User model - also used for Team Members
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  displayName   String?
  publicEmail   String?   // Email to display publicly
  avatar        String?   // Profile picture URL
  bio           Json?     // LexicalJS bio content
  role          Role      @default(WRITER)
  
  // Social Links
  twitter       String?
  facebook      String?
  instagram     String?
  dribbble      String?
  linkedin      String?
  customLinks   Json?     // Array of { name, url }
  
  // Team Member fields
  isTeamMember  Boolean   @default(false)
  teamOrder     Int       @default(0)
  teamRole      String?   // e.g., "President", "Secretary"
  
  articles      Article[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  articles  Article[]
  createdAt DateTime  @default(now())
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  articles  Article[]
  createdAt DateTime  @default(now())
}

model Article {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  content     Json          // Lexical JSON content
  excerpt     String?
  image       String?       // Featured Image URL
  status      ArticleStatus @default(DRAFT)
  author      User          @relation(fields: [authorId], references: [id])
  authorId    String
  category    Category?     @relation(fields: [categoryId], references: [id])
  categoryId  String?
  tags        Tag[]
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Event model with all required fields
model Event {
  id              String    @id @default(uuid())
  banner          String?   // Event banner image URL
  name            String
  startDate       DateTime
  endDate         DateTime
  minAge          Int?      // Age restriction minimum
  maxAge          Int?      // Age restriction maximum
  participationType String  @default("individual") // "team" or "individual"
  description     Json?     // LexicalJS content for description
  attendLink      String?   // Registration/attend link
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Media model with metadata
model Media {
  id          String   @id @default(uuid())
  filename    String
  url         String
  mimeType    String
  size        Int      // File size in bytes
  width       Int?     // Original width for images
  height      Int?     // Original height for images
  alt         String?  // Alt text for accessibility
  caption     String?  // Image caption
  
  // Metadata
  uploadedBy  String?  // User ID who uploaded
  articleId   String?  // Associated article if any
  
  createdAt   DateTime @default(now())
}
